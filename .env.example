# BeFit environment variables
# Copy this file to .env to override defaults for local development.
# Real secrets must never be committed to the repository.

# Future GroqCloud AI integration.
# NOTE: The Groq API key must never be placed in React source code or
# committed to Git. A secure proxy/key-handling strategy will be designed
# before the AI feature is implemented.
GROQ_API_KEY=your_groq_api_key_here