# BeFit environment variables
# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# Never commit a real secret to the repository.

# --- Server-side only ---
# The Groq API key used by the serverless function `api/ai/fitness.js`.
# This must NOT be prefixed with VITE_ and must never reach the browser.
GROQ_API_KEY=
